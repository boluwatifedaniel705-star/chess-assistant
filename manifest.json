{
  "manifest_version": 3,
  "name": "Chess Assistant",
  "version": "1.0",
  "description": "Suggests the best move on Chess.com using Stockfish",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://www.chess.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}